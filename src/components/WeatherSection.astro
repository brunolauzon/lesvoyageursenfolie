---
import TempChart from './TempChart.astro';
import BarsChart from './BarsChart.astro';
import SeaChart from './SeaChart.astro';
import WeatherSummary from './WeatherSummary.astro';
import { t } from '../lib/i18n';
import type { Weather } from '../schema/weather';

interface Props { weather: Weather | null; slug: string }
const { weather, slug } = Astro.props;
---
<section class="section" aria-labelledby={`weather-${slug}`}>
  <h2 id={`weather-${slug}`}>{t('weather.heading')}</h2>
  {weather ? (
    <>
      <WeatherSummary summary={weather.summary} />
      <TempChart weather={weather} id={`temp-${slug}`} />
      <BarsChart weather={weather} id={`precip-${slug}`} variable="precip" title={t('weather.precipTitle')} desc={t('weather.precipDesc')}
        valueLabel={t('weather.precip')} share="rainyShare" shareLabel={t('weather.rainProb')} barClass="bar-rain" />
      <BarsChart weather={weather} id={`sun-${slug}`} variable="sunshine_h" title={t('weather.sunTitle')} desc={t('weather.sunDesc')}
        valueLabel={t('weather.sunshine')} barClass="bar-sun" minMax={10} />
      {weather.summary.seaTemp != null ? <SeaChart weather={weather} id={`sea-${slug}`} /> : <p class="muted">{t('weather.seaMissing')}</p>}
      <p class="muted small">{t('weather.caption', { years: weather.summary.yearsUsed })} {t('weather.attribution')}</p>
    </>
  ) : <p class="muted">{t('weather.noData')}</p>}
</section>
