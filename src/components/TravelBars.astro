---
/** Stacked horizontal bars, one per resort, on a shared time scale. HTML + CSS so it wraps and reads well on phones. */
import { formatDuration, type DoorToDoor } from '../lib/travel';
import { t } from '../lib/i18n';
import { url } from '../lib/url';

interface Row { slug: string; name: string; d: DoorToDoor; estimated: boolean }
interface Props { rows: Row[]; link?: boolean }
const { rows, link = false } = Astro.props;
const sorted = [...rows].sort((a, b) => a.d.total - b.d.total);
const max = Math.max(...sorted.map((r) => r.d.total), 1);
const segs = (d: DoorToDoor) =>
  [
    { key: 'home', label: t('travel.segHome'), min: d.home },
    { key: 'checkin', label: t('travel.segCheckin'), min: d.checkin },
    { key: 'flight', label: t('travel.segFlight'), min: d.flight },
    { key: 'arrival', label: t('travel.segArrival'), min: d.arrival },
    { key: 'transfer', label: t('travel.segTransfer'), min: d.transfer },
  ].filter((s) => s.min > 0);
const legend = segs(sorted[0]?.d ?? { home: 0, checkin: 1, flight: 1, arrival: 1, transfer: 1, total: 4 });
---
<ul class="legend">
  {legend.map((s) => <li><span class={`swatch seg-${s.key}`} aria-hidden="true"></span>{s.label}</li>)}
</ul>
<ol class="travel-bars">
  {sorted.map((r) => (
    <li>
      <div class="tb-head">
        {link ? <a href={url(`resorts/${r.slug}/`)}>{r.name}</a> : <span>{r.name}</span>}
        <strong>{formatDuration(r.d.total)}{r.estimated && <> <span class="badge" title={t('travel.estimateTitle')}>{t('travel.estimate')}</span></>}</strong>
      </div>
      <div class="tb-track" aria-hidden="true">
        <div class="tb-bar" style={`width:${(r.d.total / max) * 100}%`}>
          {segs(r.d).map((s) => <span class={`seg seg-${s.key}`} style={`flex:${s.min}`} title={`${s.label}: ${formatDuration(s.min)}`}>{s.min / r.d.total > 0.14 ? formatDuration(s.min) : ''}</span>)}
        </div>
      </div>
      <p class="sr-only">{segs(r.d).map((s) => `${s.label} ${formatDuration(s.min)}`).join(', ')}</p>
    </li>
  ))}
</ol>
