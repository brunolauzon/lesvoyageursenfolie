---
import ChartFigure from './ChartFigure.astro';
import ChartAxes from './ChartAxes.astro';
import { M, H, bandPath, bandX, finite, linePath, niceTicks, scaleLinear, tripRange } from '../lib/chart';
import { formatDayMonth, formatNumber } from '../lib/format';
import { t } from '../lib/i18n';
import type { Weather } from '../schema/weather';

interface Props { weather: Weather; id: string }
const { weather, id } = Astro.props;
const days = weather.window.days;
const n = days.length;
const stat = (v: string, k: 'mean' | 'p10' | 'p90') => weather.daily.map((d) => d.stats[v]?.[k] ?? null);
const hiMean = stat('tmax', 'mean'), loMean = stat('tmin', 'mean');
const hiP10 = stat('tmax', 'p10'), hiP90 = stat('tmax', 'p90');
const loP10 = stat('tmin', 'p10'), loP90 = stat('tmin', 'p90');
const fc = weather.forecast?.days ?? [];
const fcMax = days.map((md) => fc.find((f) => f.date.slice(5) === md)?.tmax ?? null);
const fcMin = days.map((md) => fc.find((f) => f.date.slice(5) === md)?.tmin ?? null);
const all = finite([...hiP90, ...loP10, ...hiP10, ...loP90, ...fcMax, ...fcMin]);
const scale = niceTicks(Math.min(...all), Math.max(...all));
const y = scaleLinear([scale.min, scale.max], [H - M.b, M.t]);
const x = (i: number) => bandX(i, n);
const trip = tripRange(days, weather.tripDays);
const first = days[0]!, last = days.at(-1)!;
const desc = t('weather.tempDesc', { start: formatDayMonth(first), end: formatDayMonth(last), tripStart: formatDayMonth(weather.tripDays[0]!), tripEnd: formatDayMonth(weather.tripDays.at(-1)!) });
---
<ChartFigure id={id} title={t('weather.tempTitle')} desc={desc} showData={t('weather.showData')}>
  <Fragment slot="legend">
    <li><svg class="key" viewBox="0 0 28 10" aria-hidden="true"><line x1="0" x2="28" y1="5" y2="5" class="line-high" /></svg>{t('weather.high')}</li>
    <li><svg class="key" viewBox="0 0 28 10" aria-hidden="true"><line x1="0" x2="28" y1="5" y2="5" class="line-low" stroke-dasharray="6 3" /></svg>{t('weather.low')}</li>
    <li><svg class="key" viewBox="0 0 28 10" aria-hidden="true"><rect width="28" height="10" class="band-key" /></svg>{t('weather.range')}</li>
    {fc.length > 0 && <li><svg class="key" viewBox="0 0 28 10" aria-hidden="true"><line x1="0" x2="28" y1="5" y2="5" class="line-forecast" stroke-dasharray="2 3" /></svg>{t('weather.forecast')}</li>}
  </Fragment>
  <ChartAxes days={days} yTicks={scale.ticks} yMin={scale.min} yMax={scale.max} trip={trip} tripLabel={t('weather.tripWeek')} />
  <path class="band-high" d={bandPath(hiP10, hiP90, x, y)} />
  <path class="band-low" d={bandPath(loP10, loP90, x, y)} />
  <path class="line-high" d={linePath(hiMean, x, y)} fill="none" />
  <path class="line-low" d={linePath(loMean, x, y)} fill="none" stroke-dasharray="6 3" />
  {fc.length > 0 && <path class="line-forecast" d={linePath(fcMax, x, y)} fill="none" stroke-dasharray="2 3" />}
  {fc.length > 0 && <path class="line-forecast" d={linePath(fcMin, x, y)} fill="none" stroke-dasharray="2 3" />}
  <table slot="table">
    <thead><tr><th scope="col">{t('weather.day')}</th><th scope="col">{t('weather.high')} (°C)</th><th scope="col">{t('weather.low')} (°C)</th><th scope="col">10–90 %</th></tr></thead>
    <tbody>
      {days.map((md, i) => (
        <tr>
          <th scope="row">{formatDayMonth(md)}</th>
          <td>{hiMean[i] == null ? '?' : formatNumber(hiMean[i]!, 1)}</td>
          <td>{loMean[i] == null ? '?' : formatNumber(loMean[i]!, 1)}</td>
          <td>{loP10[i] == null ? '?' : `${formatNumber(loP10[i]!, 1)} – ${formatNumber(hiP90[i]!, 1)}`}</td>
        </tr>
      ))}
    </tbody>
  </table>
</ChartFigure>
