---
import { H, M, W, bandWidth, bandX, innerH, scaleLinear } from '../lib/chart';
import { formatDayMonth, formatDayNumber, formatNumber } from '../lib/format';

interface Props {
  days: string[];
  yTicks: number[];
  yMin: number;
  yMax: number;
  trip: [number, number] | null;
  tripLabel: string;
  digits?: number;
  /** Right axis, 0-100 %. */
  percentRight?: boolean;
}
const { days, yTicks, yMin, yMax, trip, tripLabel, digits = 0, percentRight = false } = Astro.props;
const y = scaleLinear([yMin, yMax], [H - M.b, M.t]);
const n = days.length;
const bw = bandWidth(n);
---
{trip && (
  <g class="trip-band">
    <rect x={M.l + trip[0] * bw} y={M.t} width={(trip[1] - trip[0] + 1) * bw} height={innerH} />
    <text x={M.l + ((trip[0] + trip[1] + 1) / 2) * bw} y={M.t + 11} text-anchor="middle" class="axis-label">{tripLabel}</text>
  </g>
)}
{yTicks.map((t) => (
  <g>
    <line class="grid" x1={M.l} x2={W - M.r} y1={y(t)} y2={y(t)} />
    <text class="axis-label" x={M.l - 6} y={y(t) + 4} text-anchor="end">{formatNumber(t, digits)}</text>
    {percentRight && (
      <text class="axis-label" x={W - M.r + 6} y={y(t) + 4}>{Math.round(((t - yMin) / (yMax - yMin)) * 100)} %</text>
    )}
  </g>
))}
{days.map((md, i) => (
  <text class="axis-label" x={bandX(i, n)} y={H - M.b + 14} text-anchor="middle">
    {i === 0 || md.endsWith('-01') ? formatDayMonth(md) : i % 2 === 0 ? formatDayNumber(md) : ''}
  </text>
))}
