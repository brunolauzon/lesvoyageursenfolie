---
/** Weight sliders, live ranking, radar and winner cards. Server-rendered with default weights; src/scripts/compare.ts updates it. */
import { buildCriteria, CRITERIA_KEYS } from '../lib/criteria';
import { t } from '../lib/i18n';
import { computeScores } from '../lib/score';
import { renderRadar, renderRanking, renderWinners, type View } from '../lib/score-view';
import type { ResortView } from '../lib/resorts';
import type { Trip } from '../schema/trip';

interface Props { views: ResortView[]; trip: Trip }
const { views, trip } = Astro.props;
const criteria = buildCriteria(views, trip);
const weights: Record<string, number> = { ...trip.score_weights };
const slugs = views.map((v) => v.entry.slug);
const view: View = {
  locale: trip.locale,
  names: Object.fromEntries(views.map((v) => [v.entry.slug, v.entry.name])),
  colorIndex: Object.fromEntries(slugs.map((s, i) => [s, i])),
};
const scores = computeScores(criteria, slugs, weights);
const payload = JSON.stringify({ criteria, view, weights });
---
<section class="section" aria-labelledby="score-h" id="score-root">
  <h2 id="score-h">{t('score.winners')}</h2>
  <div id="score-winners" set:html={renderWinners(criteria, slugs, view)} />

  <h2 id="pick-h">{t('score.heading')}</h2>
  <p class="muted">{t('score.intro')}</p>
  <div class="weights">
    {CRITERIA_KEYS.map((k) => (
      <label class="weight">
        <span>{t(`score.criteria.${k}`)}</span>
        <input type="range" min="0" max="10" step="1" value={weights[k]} data-weight={k} aria-label={t('score.weight', { name: t(`score.criteria.${k}`) })} />
        <output>{weights[k]}</output>
      </label>
    ))}
    <button type="button" id="score-reset" class="btn">{t('score.reset')}</button>
  </div>
  <div class="score-grid">
    <div id="score-ranking" set:html={renderRanking(scores, criteria, weights, view)} />
    <div id="score-radar" set:html={renderRadar(scores, criteria, weights, view)} />
  </div>
  <details class="formula"><summary>{t('score.formulaTitle')}</summary><p>{t('score.formula')}</p></details>
  <script type="application/json" id="score-data" set:html={payload} />
</section>
