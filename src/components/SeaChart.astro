---
import ChartFigure from './ChartFigure.astro';
import ChartAxes from './ChartAxes.astro';
import { M, H, bandPath, bandX, finite, linePath, niceTicks, scaleLinear, tripRange } from '../lib/chart';
import { formatDayMonth, formatNumber } from '../lib/format';
import { t } from '../lib/i18n';
import type { Weather } from '../schema/weather';

interface Props { weather: Weather; id: string }
const { weather, id } = Astro.props;
const days = weather.window.days;
const n = days.length;
const stat = (k: 'mean' | 'p10' | 'p90') => weather.daily.map((d) => d.stats.sst?.[k] ?? null);
const mean = stat('mean'), p10 = stat('p10'), p90 = stat('p90');
const all = finite([...mean, ...p10, ...p90]);
const scale = niceTicks(Math.min(...all), Math.max(...all), 4);
const y = scaleLinear([scale.min, scale.max], [H - M.b, M.t]);
const x = (i: number) => bandX(i, n);
---
<ChartFigure id={id} title={t('weather.seaTitle')} desc={t('weather.seaDesc')} showData={t('weather.showData')}>
  <Fragment slot="legend">
    <li><svg class="key" viewBox="0 0 28 10" aria-hidden="true"><line x1="0" x2="28" y1="5" y2="5" class="line-sea" /></svg>{t('weather.sea')}</li>
  </Fragment>
  <ChartAxes days={days} yTicks={scale.ticks} yMin={scale.min} yMax={scale.max} trip={tripRange(days, weather.tripDays)} tripLabel={t('weather.tripWeek')} digits={1} />
  <path class="band-sea" d={bandPath(p10, p90, x, y)} />
  <path class="line-sea" d={linePath(mean, x, y)} fill="none" />
  <table slot="table">
    <thead><tr><th scope="col">{t('weather.day')}</th><th scope="col">{t('weather.sea')}</th></tr></thead>
    <tbody>
      {days.map((md, i) => (
        <tr><th scope="row">{formatDayMonth(md)}</th><td>{mean[i] == null ? '?' : formatNumber(mean[i]!, 1)}</td></tr>
      ))}
    </tbody>
  </table>
</ChartFigure>
