---
import Base from '../../layouts/Base.astro';
import WeatherSection from '../../components/WeatherSection.astro';
import TravelSection from '../../components/TravelSection.astro';
import { loadMeta, loadResortInputs, loadTrip, loadTravel, loadWeather } from '../../lib/data';
import { t } from '../../lib/i18n';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return loadResortInputs().map((resort) => ({ params: { slug: resort.slug }, props: { resort } }));
}

const { resort } = Astro.props;
const resolved = loadMeta(resort.slug)?.resolved ?? null;
const weather = loadWeather(resort.slug);
const trip = loadTrip();
const travel = loadTravel(resort.slug);
const rows = [
  { label: t('resort.officialName'), value: resolved?.name },
  { label: t('resort.address'), value: resolved?.address },
  { label: t('resort.country'), value: resolved?.country },
];
---
<Base title={resort.name}>
  <p><a href={url()}>{t('resort.back')}</a></p>
  <h1>{resort.name}</h1>
  {resort.location && <p class="muted">{resort.location}</p>}
  <dl class="facts">
    {rows.map((r) => (
      <>
        <dt>{r.label}</dt>
        <dd>{r.value ?? <abbr title="Donnée manquante">{t('resort.unknown')}</abbr>}</dd>
      </>
    ))}
    <dt>{t('resort.website')}</dt>
    <dd>
      {resolved?.website
        ? <a href={resolved.website} rel="noopener noreferrer">{resolved.website}</a>
        : <abbr title="Donnée manquante">{t('resort.unknown')}</abbr>}
    </dd>
  </dl>
  <TravelSection travel={travel} trip={trip} slug={resort.slug} name={resort.name} />
  <WeatherSection weather={weather} slug={resort.slug} />
</Base>
