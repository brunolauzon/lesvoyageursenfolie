---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Verdict from '../components/Verdict.astro';
import Voyage from '../components/Voyage.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import WeatherOverview from '../components/WeatherOverview.astro';
import ResortJump from '../components/ResortJump.astro';
import ResortPanel from '../components/ResortPanel.astro';
import MapDefs from '../components/MapDefs.astro';
import { buildScene } from '../lib/geo';
import { countryOf, getResorts, orderByCountry } from '../lib/resorts';
import { dateFr } from '../lib/format';

// One country-grouped order for every list on the page, and one map projection shared by all maps.
const resorts = orderByCountry(await getResorts());
const scene = buildScene(resorts);
const latest = resorts.map((r) => r.meta.enrichedAt).sort().at(-1);
---

<Layout title="Vacances en Famille 2027 : Départ de YUL" updatedAt={latest ? dateFr(latest) : undefined}>
  <MapDefs scene={scene} />

  <main>
    <Hero resorts={resorts} />

    {resorts.length === 0 ? (
      <section class="mx-auto w-[min(60rem,100%-3rem)] pt-20">
        <h2 class="h-section">Aucun resort pour l’instant</h2>
        <p class="t-lead mt-4 text-muted">Ajoutez des noms de resorts dans <code>src/data/resorts-input.json</code>, puis relancez <code>npm run dev</code>.</p>
      </section>
    ) : (
      <>
        <Verdict resorts={resorts} />
        <Voyage scene={scene} />
        <ComparisonTable resorts={resorts} />
        <WeatherOverview resorts={resorts} />

        <section id="resorts" aria-labelledby="resorts-titre" class="break-before mx-auto w-[min(1600px,100%-3rem)] pt-24 md:pt-32">
          <h2 id="resorts-titre" class="h-section">Les resorts</h2>
          <p class="t-lead mt-4 mb-10 text-muted">Chaque resort en un coup d’œil. La fiche complète donne le détail du voyage et de la météo.</p>

          <ResortJump resorts={resorts} />

          <div class="space-y-4">
            {resorts.map((r, i) => {
              const country = countryOf(r);
              const newCountry = i === 0 || countryOf(resorts[i - 1]) !== country;
              return (
                <>
                  {newCountry && <h3 class="h-sub text-muted">{country ?? 'Pays à confirmer'}</h3>}
                  <ResortPanel resort={r} index={i} />
                </>
              );
            })}
          </div>
        </section>
      </>
    )}
  </main>
</Layout>
