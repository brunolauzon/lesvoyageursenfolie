---
import Base from '../layouts/Base.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import OverlayChart from '../components/OverlayChart.astro';
import ScorePanel from '../components/ScorePanel.astro';
import TravelCompare from '../components/TravelCompare.astro';
import { loadResortViews, loadTrip } from '../lib/resorts';
import { formatDate } from '../lib/format';
import { t } from '../lib/i18n';

const trip = loadTrip();
const views = loadResortViews();
---
<Base title={t('home.heading')}>
  <h1>{t('home.heading')}</h1>
  <p class="muted">
    {t('home.trip', { start: formatDate(trip.stay.start), end: formatDate(trip.stay.end), travelers: trip.travelers, airport: trip.origin.airport })}
  </p>
  <ScorePanel views={views} trip={trip} />
  <ComparisonTable views={views} trip={trip} />
  <TravelCompare resorts={views.map((v) => ({ slug: v.entry.slug, name: v.entry.name }))} trip={trip} />
  <OverlayChart resorts={views.map((v) => ({ slug: v.entry.slug, name: v.entry.name, weather: v.weather }))} />
  <script>import '../scripts/compare';</script>
</Base>
